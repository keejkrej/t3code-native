{
  "name": "t3code-native",
  "version": "1.0.0",
  "description": "T3 Code Native - React Native Desktop Client for AI Coding Agents",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --platform=node --target=node20 --outdir=dist-electron --format=cjs --out-extension:.js=.cjs",
    "build": "pnpm build:web && pnpm build:electron",
    "typecheck": "tsc --noEmit",
    "desktop": "electron .",
    "postinstall": "node scripts/ensure-electron.cjs",
    "server:build": "cd server && go build -o bin/t3server ./cmd/t3server",
    "server:run": "cd server && go run ./cmd/t3server",
    "server:test": "cd server && go test -v ./..."
  },
  "keywords": [
    "t3code",
    "react-native",
    "desktop",
    "electron",
    "agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.19.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native-web": "^0.19.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^34.5.8",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
